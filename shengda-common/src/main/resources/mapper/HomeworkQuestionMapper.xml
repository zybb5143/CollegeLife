<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.HomeworkQuestionMapper">
    
    <resultMap id="QuestionResultMap" type="com.example.demo.model.HomeworkQuestion">
        <id column="question_id" property="questionId"/>
        <result column="admin_name" property="adminName"/>
        <result column="course_name" property="courseName"/>
        <result column="question_title" property="questionTitle"/>
        <result column="question_content" property="questionContent"/>
        <result column="reference_answer" property="referenceAnswer"/>
        <result column="total_score" property="totalScore"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <!-- 发布题目 -->
    <insert id="insertQuestion" parameterType="com.example.demo.model.HomeworkQuestion">
        INSERT INTO homework_question (admin_name, course_name, question_title, question_content, reference_answer, total_score)
        VALUES (#{adminName}, #{courseName}, #{questionTitle}, #{questionContent}, #{referenceAnswer}, #{totalScore})
    </insert>

    <!-- 查询所有题目 -->
    <select id="selectAllQuestions" resultMap="QuestionResultMap">
        SELECT * FROM homework_question ORDER BY create_time DESC
    </select>

    <!-- 根据ID查询 -->
    <select id="selectQuestionById" resultMap="QuestionResultMap">
        SELECT * FROM homework_question WHERE question_id = #{questionId}
    </select>

    <!-- 根据课程名称查询 -->
    <select id="selectByCourseName" resultMap="QuestionResultMap">
        SELECT * FROM homework_question WHERE course_name = #{courseName} ORDER BY create_time DESC
    </select>
</mapper>
