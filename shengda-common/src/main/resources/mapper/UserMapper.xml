<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.UserMapper">
    <!-- 结果映射 -->
    <resultMap id="UserResultMap" type="com.example.demo.model.User">
        <id column="user_name" property="userName" />
        <result column="user_password" property="userPassword" />
        <result column="user_register_time" property="userRegisterTime" />
        <result column="user_email" property="userEmail" />
        <result column="user_gender" property="userGender" />
        <result column="role" property="role" />
        <result column="continuous_checkin_days" property="continuousCheckinDays" />
        <result column="last_checkin_date" property="lastCheckinDate" />
    </resultMap>
    <!-- 根据用户名查询用户 -->
    <select id="getUserByUserName" resultMap="UserResultMap">
        SELECT user_name, user_password, user_register_time, user_email, user_gender, role, continuous_checkin_days, last_checkin_date
        FROM user 
        WHERE user_name = #{userName}
    </select>
    <!-- 更新用户信息 -->
    <update id="updateUser" >
        UPDATE user
        <set>
            <if test="userPassword != null">
                user_password = #{userPassword},
            </if>
            <if test="userEmail != null">
                user_email = #{userEmail},
            </if>
            <if test="userGender != null">
                user_gender = #{userGender},
            </if>
        </set>
        WHERE user_name = #{userName}
    </update>
    <!-- 插入新用户 -->
    <insert id="insertUser" >
        INSERT INTO user (user_name, user_password, user_email, user_gender)
        VALUES (#{userName}, #{userPassword}, #{userEmail}, #{userGender})
    </insert>

    <!-- 删除用户 -->
    <delete id="deleteUser">
        DELETE FROM user WHERE user_name = #{userName}
    </delete>

    <!-- 更新签到信息 -->
    <update id="updateCheckinInfo">
        UPDATE user
        SET continuous_checkin_days = #{continuousDays},
            last_checkin_date = #{lastDate}
        WHERE user_name = #{userName}
    </update>

    <!-- 获取所有用户名 -->
    <select id="getAllUserNames" resultType="java.lang.String">
        SELECT user_name FROM user
    </select>
</mapper>