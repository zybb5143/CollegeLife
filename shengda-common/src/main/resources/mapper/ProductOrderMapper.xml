<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.ProductOrderMapper">
    
    <resultMap id="ProductOrderResult" type="com.example.demo.model.ProductOrder">
        <result column="order_id" property="orderId"/>
        <result column="order_no" property="orderNo"/>
        <result column="product_id" property="productId"/>
        <result column="seller_name" property="sellerName"/>
        <result column="buyer_name" property="buyerName"/>
        <result column="product_name" property="productName"/>
        <result column="product_image" property="productImage"/>
        <result column="price" property="price"/>
        <result column="status" property="status"/>
        <result column="payment_time" property="paymentTime"/>
        <result column="complete_time" property="completeTime"/>
        <result column="cancel_reason" property="cancelReason"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>
    
    <!-- 创建订单 -->
    <insert id="insert" parameterType="com.example.demo.model.ProductOrder" useGeneratedKeys="true" keyProperty="orderId">
        INSERT INTO product_order (
            order_no, product_id, seller_name, buyer_name,
            product_name, product_image, price, status
        ) VALUES (
            #{orderNo}, #{productId}, #{sellerName}, #{buyerName},
            #{productName}, #{productImage}, #{price}, #{status}
        )
    </insert>
    
    <!-- 根据订单 ID 查询 -->
    <select id="getById" resultMap="ProductOrderResult">
        SELECT * FROM product_order 
        WHERE order_id = #{orderId}
    </select>
    
    <!-- 根据订单编号查询 -->
    <select id="getByOrderNo" resultMap="ProductOrderResult">
        SELECT * FROM product_order 
        WHERE order_no = #{orderNo}
    </select>
    
    <!-- 查询卖家订单 -->
    <select id="listBySeller" resultMap="ProductOrderResult">
        SELECT * FROM product_order 
        WHERE seller_name = #{sellerName}
        ORDER BY create_time DESC
    </select>
    
    <!-- 查询买家订单 -->
    <select id="listByBuyer" resultMap="ProductOrderResult">
        SELECT * FROM product_order 
        WHERE buyer_name = #{buyerName}
        ORDER BY create_time DESC
    </select>
    
    <!-- 更新订单状态 -->
    <update id="updateStatus">
        UPDATE product_order 
        SET status = #{status}
        WHERE order_id = #{orderId}
    </update>
    
    <!-- 更新支付时间 -->
    <update id="updatePaymentTime">
        UPDATE product_order 
        SET payment_time = NOW(),
            status = 'paid'
        WHERE order_id = #{orderId}
    </update>
    
    <!-- 更新完成时间 -->
    <update id="updateCompleteTime">
        UPDATE product_order 
        SET complete_time = NOW(),
            status = 'completed'
        WHERE order_id = #{orderId}
    </update>
    
    <!-- 取消订单 -->
    <update id="cancelOrder">
        UPDATE product_order 
        SET status = 'cancelled',
            cancel_reason = #{cancelReason}
        WHERE order_id = #{orderId}
    </update>
</mapper>
