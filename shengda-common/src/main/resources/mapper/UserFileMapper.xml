<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.UserFileMapper">

    <resultMap id="BaseResultMap" type="com.example.demo.model.UserFile">
        <id column="file_id" property="fileId"/>
        <result column="user_name" property="userName"/>
        <result column="file_name" property="fileName"/>
        <result column="file_path" property="filePath"/>
        <result column="file_size" property="fileSize"/>
        <result column="file_type" property="fileType"/>
        <result column="upload_time" property="uploadTime"/>
    </resultMap>

    <!-- 插入文件信息 -->
    <insert id="insert" parameterType="com.example.demo.model.UserFile" useGeneratedKeys="true" keyProperty="fileId">
        INSERT INTO user_file (
            user_name,
            file_name,
            file_path,
            file_size,
            file_type,
            upload_time
        ) VALUES (
            #{userName},
            #{fileName},
            #{filePath},
            #{fileSize},
            #{fileType},
            NOW()
        )
    </insert>

    <!-- 根据用户名查询文件列表 -->
    <select id="selectByUserName" resultMap="BaseResultMap">
        SELECT * FROM user_file
        WHERE user_name = #{userName}
        ORDER BY upload_time DESC
    </select>
    
    <!-- 查询所有文件（管理员用） -->
    <select id="selectAllFiles" resultMap="BaseResultMap">
        SELECT * FROM user_file
        ORDER BY upload_time DESC
    </select>

    <!-- 根据文件 ID 查询 -->
    <select id="selectByFileId" resultMap="BaseResultMap">
        SELECT * FROM user_file
        WHERE file_id = #{fileId}
    </select>

    <!-- 根据文件 ID 删除 -->
    <delete id="deleteByFileId">
        DELETE FROM user_file
        WHERE file_id = #{fileId}
    </delete>

</mapper>
